{
  "name": "aeofixer",
  "version": "0.1.0",
  "description": "AEO optimiser for AI-powered browsers and search engines",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "tsc -p tsconfig.build.json && cd client && npm run build",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts,.tsx && cd client && npm run lint",
    "typecheck": "tsc --noEmit && cd client && npm run typecheck",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.30.0",
    "express": "^4.19.0",
    "openai": "^4.47.0",
    "pg": "^8.11.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "concurrently": "^8.2.0",
    "drizzle-kit": "^0.21.0",
    "eslint": "^8.57.0",
    "supertest": "^7.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
